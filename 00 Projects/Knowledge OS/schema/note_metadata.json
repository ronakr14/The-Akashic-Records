{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Note Metadata",
  "type": "object",
  "required": ["path", "title", "note_type", "word_count"],
  "properties": {
    "path": { "type": "string" },
    "title": { "type": "string" },
    "note_type": {
      "type": "string",
      "enum": ["concept", "adr", "project", "question", "reference", "curated", "interview", "prompt", "unknown"]
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "word_count": { "type": "integer" },
    "heading_count": { "type": "integer" },
    "link_count": { "type": "integer" },
    "outgoing_links": { "type": "array", "items": { "type": "string" } },
    "incoming_links": { "type": "array", "items": { "type": "string" } },
    "has_code_examples": { "type": "boolean" },
    "has_decision_matrix": { "type": "boolean" },
    "has_interview_qa": { "type": "boolean" },
    "has_related_section": { "type": "boolean" },
    "file_size_bytes": { "type": "integer" },
    "last_modified": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
