{
    "repository_path": "C:\\Workspace\\The-Akashic-Records",

    "output_file": ".repo-metadata\\repository_files.csv",

    "metadata_file": ".repo-metadata\\repository_files.csv",

    "scan_history_file": ".repo-metadata\\scan_history.csv",

    "exclude_dirs": [
        ".git",
        ".obsidian",
        ".idea",
        ".vscode",
        "__pycache__",
        ".venv",
        "venv",
        "node_modules",
        "dist",
        "build",
        ".repo-metadata"
