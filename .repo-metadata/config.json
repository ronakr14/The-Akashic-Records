    "exclude_extensions": [
        ".db",
        ".sqlite",
        ".sqlite3"
    ],

    "follow_symlinks": false,

    "collect_git_metadata": true,

    "calculate_content_hash": true,

    "hash_algorithm": "sha256",

    "rename_detection": true
